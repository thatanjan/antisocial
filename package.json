{
  "name": "antisocial",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev --no-daemon",
    "build": "turbo run build --no-daemon",
  "lint": "turbo run lint --no-daemon",
    "lint:write": "biome check --changed --write --unsafe",
    "format": "turbo run format --no-daemon",
    "typecheck": "turbo run check-types --no-daemon",
    "check-types": "turbo run check-types --no-daemon"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "turbo": "^2.11.7"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "11.11.0"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
