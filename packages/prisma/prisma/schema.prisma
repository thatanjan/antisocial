// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  user
  recruiter
}

enum CompanyRole {
  owner
  recruiter
  member
}

enum RequestStatus {
  pending
  approved
  denied
}

enum JobStatus {
  draft
  open
  closed
}

enum JobType {
  full_time
  part_time
  contract
  internship
  temporary
}

enum RemoteType {
  onsite
  hybrid
  remote
}

enum ExperienceLevel {
  intern
  entry
  mid
  senior
  lead
}

/// Employee tiers: tiny 1-10, small 11-50, medium 51-200, large 201-500, xlarge 500+.
enum CompanySize {
  tiny
  small
  medium
  large
  xlarge
}

enum SalaryPeriod {
  hourly
  monthly
  yearly
}

model User {
  id                     String                 @id
  name                   String
  email                  String
  emailVerified          Boolean
  image                  String?
  isAnonymous            Boolean                @default(false)
  createdAt              DateTime
  updatedAt              DateTime
  followerCount          Int                    @default(0)
  followingCount         Int                    @default(0)
  role                   UserRole               @default(user)
  headline               String?
  bio                    String?
  country                String?
  sessions               Session[]
  accounts               Account[]
  posts                  Post[]
  postLikes              PostLikes[]
  comments               PostComment[]
  replies                CommentReply[]
  commentLikes           CommentLike[]
  replyLikes             ReplyLike[]
  unreadNotifications    Int                    @default(0)
  following              Follow[]               @relation("Follower")
  followers              Follow[]               @relation("Followee")
  notificationsSent      Notification[]         @relation("NotificationActor")
  notificationsReceived  Notification[]         @relation("NotificationRecipient")
  companyMemberships     CompanyMember[]
  companyMemberRequests  CompanyMemberRequest[] @relation("CompanyMemberRequester")
  companyMemberDecisions CompanyMemberRequest[] @relation("CompanyMemberDecider")
  companyFollows         CompanyFollow[]
  jobsPosted             Job[]
  savedJobs              SavedJob[]
  jobExperiences         JobExperience[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@index([identifier])
  @@map("verification")
}

model Post {
  id            String         @id @default(cuid())
  authorId      String
  author        User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content       String?        @db.Text
  aspectRatio   String?
  images        PostImage[]
  likeCount     Int            @default(0)
  postLikes     PostLikes[]
  commentCount  Int            @default(0)
  comments      PostComment[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  notifications Notification[]

  @@index([authorId])
  @@map("post")
}

model PostLikes {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, postId])
  @@index([userId])
  @@index([postId])
  @@map("post_likes")
}

model PostImage {
  id         String @id @default(cuid())
  postId     String
  post       Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  url        String
  fileId     String
  orderIndex Int

  @@index([postId])
  @@map("post_image")
}

model PostComment {
  id           String         @id @default(cuid())
  postId       String
  post         Post           @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId     String
  author       User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content      String         @db.VarChar(2000)
  likeCount    Int            @default(0)
  replyCount   Int            @default(0)
  replies      CommentReply[]
  commentLikes CommentLike[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([postId])
  @@index([authorId])
  @@map("post_comment")
}

model CommentReply {
  id         String      @id @default(cuid())
  commentId  String
  comment    PostComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  authorId   String
  author     User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content    String      @db.VarChar(2000)
  likeCount  Int         @default(0)
  replyLikes ReplyLike[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([commentId])
  @@index([authorId])
  @@map("comment_reply")
}

model CommentLike {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  commentId String
  comment   PostComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@unique([userId, commentId])
  @@index([userId])
  @@index([commentId])
  @@map("comment_like")
}

model ReplyLike {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  replyId   String
  reply     CommentReply @relation(fields: [replyId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@unique([userId, replyId])
  @@index([userId])
  @@index([replyId])
  @@map("reply_like")
}

model Follow {
  id         String   @id @default(cuid())
  followerId String
  followeeId String
  follower   User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  followee   User     @relation("Followee", fields: [followeeId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([followerId, followeeId])
  @@index([followerId, createdAt(sort: Desc)])
  @@index([followeeId, createdAt(sort: Desc)])
  @@map("follow")
}

model Notification {
  id          String   @id @default(cuid())
  recipientId String
  postId      String?
  actorId     String?
  type        String
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())
  companyId   String?

  recipient User     @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor     User?    @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  post      Post?    @relation(onDelete: Cascade, fields: [postId], references: [id])
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([recipientId, createdAt(sort: Desc)])
  @@index([recipientId, read])
  @@index([createdAt])
  @@index([companyId])
  @@map("notification")
}

/// Application invariant: each company has exactly one owner membership; ownership cannot transfer.
model Company {
  id             String                 @id @default(cuid())
  name           String
  slug           String                 @unique
  description    String?
  image          String?
  coverImage     String?
  industry       String?
  website        String?
  size           CompanySize?
  country        String?
  followerCount  Int                    @default(0)
  memberCount    Int                    @default(0)
  jobCount       Int                    @default(0)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  members        CompanyMember[]
  memberRequests CompanyMemberRequest[]
  followers      CompanyFollow[]
  jobs           Job[]
  notifications  Notification[]
  jobExperiences JobExperience[]

  @@index([country])
  @@map("company")
}

model CompanyMember {
  id        String      @id @default(cuid())
  companyId String
  userId    String
  role      CompanyRole
  /// Application validation requires a non-empty title.
  roleName  String
  createdAt DateTime    @default(now())
  company   Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
  @@index([userId])
  @@map("company_member")
}

/// Application logic allows at most one pending request per company and user.
model CompanyMemberRequest {
  id            String        @id @default(cuid())
  companyId     String
  userId        String
  requestedRole CompanyRole
  /// Application validation requires a non-empty title and rejects the owner role.
  roleName      String
  status        RequestStatus @default(pending)
  decidedById   String?
  decidedAt     DateTime?
  createdAt     DateTime      @default(now())
  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user          User          @relation("CompanyMemberRequester", fields: [userId], references: [id], onDelete: Cascade)
  decidedBy     User?         @relation("CompanyMemberDecider", fields: [decidedById], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([userId])
  @@index([status])
  @@map("company_member_request")
}

model CompanyFollow {
  id        String   @id @default(cuid())
  userId    String
  companyId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId])
  @@map("company_follow")
}

model Job {
  id              String           @id @default(cuid())
  title           String
  slug            String           @unique
  description     String?          @db.Text
  companyId       String
  postedById      String
  status          JobStatus        @default(draft)
  jobType         JobType
  remoteType      RemoteType?
  experienceLevel ExperienceLevel?
  country         String?
  salaryMin       Int?
  salaryMax       Int?
  salaryCurrency  String           @default("USD")
  salaryPeriod    SalaryPeriod?
  tags            String[]         @default([])
  applyUrl        String?
  applyCount      Int              @default(0)
  savedCount      Int              @default(0)
  deadline        DateTime?
  publishedAt     DateTime?
  closedAt        DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  postedBy        User             @relation(fields: [postedById], references: [id], onDelete: Cascade)
  savedBy         SavedJob[]

  @@index([companyId])
  @@index([postedById])
  @@index([status])
  @@index([country])
  @@map("job")
}

/// A user's work history entry on their profile.
/// Exactly one of `companyId` or `companyName` is set: the FK when the
/// company exists on the platform, the free-text name otherwise.
model JobExperience {
  id          String    @id @default(cuid())
  userId      String
  companyId   String?
  companyName String?
  title       String
  startDate   DateTime
  /// Null means the user is still working there.
  endDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  company     Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([companyId])
  @@map("job_experience")
}

model SavedJob {
  id        String   @id @default(cuid())
  userId    String
  jobId     String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([jobId])
  @@map("saved_job")
}
